{
	"name": "cracker-music",
	"version": "1.0.0",
	"description": "Scale-degree frequency analysis of Christmas carols",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm slugs && vite --config site/vite.config.ts",
		"build": "pnpm slugs && svelte-check --tsconfig ./tsconfig.json && vite build --config site/vite.config.ts",
		"dev:transcriber": "vite --config transcriber/vite.config.ts",
		"storybook": "pnpm slugs && storybook dev -p 6006",
		"build-storybook": "pnpm slugs && storybook build",
		"lint": "pnpm slugs && prettier --check . && eslint . && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"slugs": "tsx scripts/slugs.ts",
		"format": "prettier --write ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@poppanator/sveltekit-svg": "7.0.1",
		"@storybook/svelte-vite": "10.6.6",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"eslint": "^10.14.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-storybook": "10.6.6",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"post-lab": "link:../post-lab",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"storybook": "10.6.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.70.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tonal": "^6.5.1",
		"tone": "^15.1.22"
	}
}
